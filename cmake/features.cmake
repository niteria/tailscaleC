include(CheckCSourceCompiles)

function(tsc_read_features prefix)
    if(NOT DEFINED TSC_CONFIG_HEADER OR TSC_CONFIG_HEADER STREQUAL "")
        set(TSC_CONFIG_HEADER "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../config.h")
    endif()
    get_filename_component(header "${TSC_CONFIG_HEADER}" ABSOLUTE
        BASE_DIR "${CMAKE_SOURCE_DIR}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${header}")
    set(CMAKE_REQUIRED_INCLUDES "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../include")
    set(CMAKE_REQUIRED_DEFINITIONS "-DTSC_CONFIG_HEADER=\"${header}\"")
    set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
    foreach(feature CLIENT APP_UDP APP_TCP TLS DISCO DERP STUN IPV6)
        if(feature MATCHES "^APP_")
            set(macro "TSC_${feature}")
        else()
            set(macro "TSC_ENABLE_${feature}")
        endif()
        unset(TSC_CHECK_${feature} CACHE)
        check_c_source_compiles("#include <tailscalec/config.h>\n#if !${macro}\n#error disabled\n#endif\nint tsc_feature_check(void) { return 0; }"
            TSC_CHECK_${feature})
        if(TSC_CHECK_${feature})
            set(${prefix}_${feature} ON PARENT_SCOPE)
        else()
            set(${prefix}_${feature} OFF PARENT_SCOPE)
        endif()
    endforeach()
endfunction()
