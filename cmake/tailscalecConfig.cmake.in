@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
if(@TSC_NEEDS_CRYPTO@)
    find_dependency(OpenSSL 3.0 COMPONENTS Crypto)
endif()
if(@TSC_TLS@)
    find_dependency(OpenSSL 3.0 COMPONENTS SSL)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/tailscalecTargets.cmake")
check_required_components(tailscalec)
